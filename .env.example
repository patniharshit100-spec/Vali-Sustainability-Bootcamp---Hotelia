# Hotel Insight — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Leave blank or set to "demo" to run in mock mode (no API calls made).
VITE_ANTHROPIC_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from your Supabase project Settings → API.
# Leave blank to run in Demo Mode (mock data, no Supabase connection).
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── VAPI / Whisper (Call Center) ──────────────────────────────────────────────
# Used by vapiService.ts for voice transcription.
# Leave blank to run in mock/simulation mode.
VITE_VAPI_API_KEY=
VITE_WHISPER_ENDPOINT=

# ── Note on browser-side API calls ───────────────────────────────────────────
# This prototype calls the Anthropic API directly from the browser for
# simplicity. In production, route all AI calls through a backend proxy
# (e.g. an Express/Next.js API route) so the key is never exposed to clients.
